# BigDataCloud reverse-geocode-with-timezone API key
# Get a free key at https://www.bigdatacloud.com/free-usage-stories/reverse-geocode-with-timezone
REVERSE_GEOCODING_WITH_TIMEZONE_API=your_key_here

# Canonical production URL (used for metadataBase, OG tags, robots, sitemap).
# Leave unset locally; set on Vercel to your deployed domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
